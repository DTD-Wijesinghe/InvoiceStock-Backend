# Server-side only. Use a dedicated Supabase project.
# Choose session-mode pooler port 5432 for a persistent IPv4 backend.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
JWT_SECRET=REPLACE_WITH_48_OR_MORE_RANDOM_CHARACTERS
FRONTEND_ORIGIN=https://YOUR_APP.onrender.com
PUBLIC_URL=https://YOUR_APP.onrender.com
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
BACKUP_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_48_RANDOM_CHARACTERS
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=
AI_API_KEY=
